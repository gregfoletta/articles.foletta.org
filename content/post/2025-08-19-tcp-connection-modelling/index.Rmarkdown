```{r include=FALSE}
library(tidyverse)
library(jsonlite)
library(cmdstanr)
library(tidybayes)
```
    
```{r eval=FALSE, include=FALSE}
# Original loading, now using RDS
packets_raw <-
    file('tcp_train.pcap.json') |>
    stream_in(flatten = TRUE, simplifyVector = TRUE) |>
    rename_with(.fn = ~{ str_remove(.x, 'layers\\.') }) |>
    unnest(-timestamp) |>
    mutate(packet_id = 1:n())
```
```{r}
packets_raw <- read_rds('packets.Rds')
```

```{r}
packets <-
    packets_raw |>
    # Everything comes in as a character, fix up the types
    mutate(
        timestamp = (as.double(timestamp)/1000) |> as.POSIXct(),
        tcp_time_relative = as.double(tcp_time_relative) |> as.duration(),
        tcp_completeness = as.double(tcp_completeness),
        ip_version = as.double(ip_version),
        ip_len = as.double(ip_len),
        tcp_stream = as.double(tcp_stream),
        udp_stream = as.double(udp_stream)
    ) |> 
    # Adda a UDP ccomnpleteness column based on first/last datagram
    group_by(udp_stream) |>
    mutate(udp_completeness = case_when(
        !is.na(tcp_stream) ~ NA,
        row_number() == 1 ~ 0,
        row_number() == n() ~ 3,
        .default = 1
    )) |>
    # Add a 'time_relative' for UDP which shows the connection time
    mutate(udp_time_relative = if_else(is.na(tcp_stream), timestamp - first(timestamp), NA)) |> 
    ungroup() |>
    # Coalesce the common TCP/UDP columns
    mutate(
        srcport = coalesce(tcp_srcport, udp_srcport),
        dstport = coalesce(tcp_dstport, udp_dstport),
        stream = coalesce(tcp_stream, udp_stream),
        time_relative = coalesce(tcp_time_relative, udp_time_relative)
    ) |>
    select(-c(tcp_srcport, udp_srcport, tcp_dstport, udp_dstport, tcp_stream, udp_stream, tcp_time_relative, udp_time_relative)) |>
    # Pivot longer on the completelness column
    pivot_longer(
        cols = c(tcp_completeness, udp_completeness),
        names_to = 'protocol',
        values_to = 'completeness',
        values_drop_na = TRUE
    ) |>
    mutate(protocol = str_remove(protocol, '_completeness'))
```
   
   
```{r}
# Filter out only completed connections
packets <-
    packets |>
    group_by(stream, protocol) |>
    filter(
        (protocol == 'tcp' & any(completeness >= 31)) |
        (protocol == 'udp' & any(completeness == 3))
    ) |> 
    ungroup()
```
    
```{r}
# Add a 1/-1 indicator when a connection is added/completed
packets <-
    packets |>
    mutate(
        new_connection = case_when(
            protocol == 'tcp' & completeness == 0 ~ 1,
            protocol == 'udp' & completeness == 0 ~ 1,
            .default = 0
        ),
        # This will include multiple per stream (i.e. [FIN],[ACK],[FIN],[ACK]
        # We filter this out later
        complete_connection = case_when(
            protocol == 'tcp' & completeness >= 31 ~ -1,
            protocol == 'udp' & completeness == 3 ~ -1,
            .default = 0
        )
    )
```
    
```{r}
connections_per_protocol <-
    packets |> 
    group_by(stream, protocol) |>
    filter(cumsum(complete_connection) > -2) |>
    ungroup() |> 
    group_by(protocol, timestamp = floor_date(timestamp, '1 second')) |>
    summarise(
        new_cps = sum(new_connection),
        complete_cps = -sum(complete_connection),
        .groups = 'drop'
    ) |>
    complete(
        timestamp = seq(min(timestamp), max(timestamp), by = '1 sec'),
        protocol = unique(protocol),
        fill = list(new_cps = 0, complete_cps = 0)
    ) |>
    arrange(timestamp) |> 
    group_by(protocol) |> 
    mutate(
        second = 1:n(),
        concurrent_connections = cumsum(new_cps - complete_cps)
    ) |>
    ungroup() |>
    mutate(
        protocol = as.factor(toupper(protocol)),
        proto_index = as.integer(protocol)
    ) |> 
    select(timestamp, second, everything())

connections <-
    connections_per_protocol |>
    group_by(timestamp, second) |>
    summarise(
        new_cps = sum(new_cps),
        complete_cps = sum(complete_cps),
        concurrent_connections = sum(concurrent_connections),
        .groups = 'drop'
    )
```

    
    
```{r}
connections_per_protocol |>
    ggplot() +
    geom_line(data = connections, aes(timestamp, concurrent_connections, colour = "Aggregate")) +
    geom_line(aes(timestamp, concurrent_connections, colour = protocol)) 
```

```{r}
connections_per_protocol |>
    ggplot() +
    geom_histogram(aes(complete_cps), binwidth = 1) +
    facet_wrap(vars(protocol))
```
   
    
```{r}
connections_per_protocol |>
    ggplot() +
    geom_histogram(aes(concurrent_connections), binwidth = 1) +
    facet_wrap(vars(protocol))
```
    
    
# First Model

```{stan eval=FALSE, include=FALSE}
model {
    mu_n ~ lognormal(0, 1.5);
    mu_c ~ lognormal(0, 1.5);
    phi_n ~ exponential(1);
    phi_c ~ exponential(1);

    new_cps[t] ~ neg_binomial_2(mu_n, phi_n);
    complete_cps[t] ~ neg_binomial_2(mu_c, phi_c);
}
```


```{r}
m1.1_constant_mean <- cmdstan_model('m1.1_constant_means.stan')

m1.1_fit <- m1.1_constant_mean$sample(
    data = compose_data(
        connections |> select(-timestamp),
        c0 = 0,
        .n_name = n_prefix('t')
    ),
    chains = 4,
    parallel_chains = 4
)
```

```{r}
m1.1_draws <-
    m1.1_fit |>
    spread_draws(c_pred[i]) |>
    ungroup()

m1.1_draws |>
    filter(.draw %in% 1:300) |>
    ggplot() +
    geom_line(aes(i, c_pred, group = .draw), alpha = .3)
```

```{r}
# Clean Up
rm(m1.1_draws)
```



```{stan}
model {
    mu_n ~ lognormal(0, 1.5);
    phi_n ~ exponential(1);
    prev_complete ~ beta(1,1);

    new_cps[t] ~ neg_binomial_2(mu_n, phi_n);
  
    int c_prev = c0; 
    for (i in 1:t) {
        complete_cps[t] ~ binomial(c_prev, prev_complete);
        
        c_prev = c_prev + new_cps[t] - complete_cps[t];
    }
}
```


```{r}
m1.2_concurrency_dependent <- cmdstan_model('m1.2_concurrency_dependent.stan')

m1.2_fit <- m1.2_concurrency_dependent$sample(
    data = compose_data(
        connections |> select(-timestamp),
        c0 = 0,
        .n_name = n_prefix('t')
    ),
    chains = 4,
    parallel_chains = 4,
    step_size = 1,
    thin = 4
)
```
```{r}
m1.2_fit |>
    gather_draws(mu_n, phi_n, prev_complete) |>
    ungroup() |>
    ggplot() +
    geom_histogram(aes(.value, colour = .chain), bins = 100) +
    facet_wrap(vars(.variable), scales = 'free')
```
```{r}
m1.2_draws <-
    m1.2_fit |>
    spread_draws(c_pred[i]) |>
    ungroup()
```



```{r}
m1.2_draws|>
    filter(.draw %in% sample(max(.draw), 9)) |>
    ggplot() +
    geom_histogram(data = connections, aes(concurrent_connections, fill = 'real'), binwidth = 1) +
    geom_histogram(aes(c_pred, fill = 'generated'), binwidth = 1, alpha = .8) +
    facet_wrap(vars(.draw)) +
    labs(
        fill = 'Data Type'
    )
```

```{r}
rm(m1.1_draws)
```


# Model 3

```{r}
m1.3_proto <- cmdstan_model('m1.3_protocol_concurrency.stan')

m1.3_fit <- m2_arima$sample(
    data = compose_data(
        connections_per_protocol |>
            select(-timestamp) |>
            rename(p_index = proto_index),
        c0 = 0,
        .n_name = n_prefix('t')
    ),
    chains = 4,
    parallel_chains = 4
)
```

