```{r}
forecast_accuracy |>
    group_by(location) |>
    nest() |>
    ungroup() |>
    slice_sample(n = 4) |>
    unnest(data) |>
    filter(forecast_period == 86400*1) |> 
    ggplot() +
    geom_point(aes(forecast_datetime_local, temperature_rounded), shape = 2) +
    geom_line(aes(forecast_datetime_local, temperature_rounded)) +
    geom_point(aes(forecast_datetime_local, forecast_temp, colour = location)) +
    geom_line(aes(forecast_datetime_local, forecast_temp, colour = location)) +
    facet_wrap(~location) +
    labs(
        colour = "Forecast Temp"
    )
```
```{r}
forecast_accuracy |>
    ggplot() +
    geom_histogram(aes(temp_diff, after_stat(density), fill = as_factor(forecast_period)), binwidth = .1) +
    facet_wrap(vars(forecast_period))
```


```{r}
forecast_accuracy |>
    group_by(forecast_period) |>
    summarise(
        mean(temp_diff_rounded),
        sd(temp_diff_rounded)

            )
```


```{r}
wmo_sd <-
    forecast_accuracy |>
    group_by(wmo) |>
    summarise(sd = sd(temp_diff_rounded)) |>
    right_join(weather_stations, by = 'wmo') |>  
    select(wmo, lat, lon, site_name, sd)

aus |> 
 ggplot() +
    geom_sf() +
    geom_point(data = wmo_sd, aes(x = lon, y = lat, colour = sd), size = .4) +
    labs(
        x = '',
        y = ''
    )
    
```

```{r}
wmo_sd |>
    slice_max(sd) |>
    right_join(forecast_accuracy, by = 'wmo') |>
    ggplot() +
    geom_p
```

