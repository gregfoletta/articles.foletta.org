```{r include=FALSE}
library(tidyverse)
library(httr2)
library(rvest)
library(janitor)
library(glue)
library(rnaturalearth)
library(rnaturalearthdata)
library(tictoc)
library(here)
```

```{r}
# Load the current temperature data
temp_data <-
    list.files('temp_data', recursive = TRUE, pattern = '*.csv', full.names = TRUE) |>
    read_csv(show_col_types = FALSE) |>
    rename(
        request_datetime_utc = request_date,
        temp_time_local = current_temp_time,
        temperature = current_temp
    ) |> 
    # Create a 10 minute floored time
    mutate(request_datetime_utc_floored = floor_date(request_datetime_utc, '10 minutes')) |>
    # Remove any duplicate entries
    separate(location, into = c('city', 'state'), sep = ', ')


# Calculating the current temp time's date, as it isn't on the page. 
# Find the the time when the reuest_datetime is UTC 00:00:00, which is 
# by definition the timezone, then add this on to the request datetime
wmo_timezones <-
    temp_data |>
    filter(
        hour(request_datetime_utc_floored) == 0 &
        minute(request_datetime_utc_floored) == 0 &
        second(request_datetime_utc_floored) == 0
    ) |>
    #### FIXME: Daylight Savings Change ####
    group_by(wmo) |>
    slice_head(n = 1) |>
    ungroup() |>
    select(wmo, timezone = temp_time_local)

# Use the timezone to calculate the time of the temperature
# in the local time of the weather station
temp_data <-
    temp_data |>
    left_join(wmo_timezones, by = 'wmo') |>
    mutate(
        request_datetime_local_floored = request_datetime_utc_floored + timezone,
        temp_datetime_local = as_datetime(date(request_datetime_utc_floored + timezone)) + temp_time_local) |>
        select(request_datetime_utc, request_datetime_utc_floored, request_datetime_local_floored, temp_datetime_local, temp_time_local, everything()
    ) |> 
    distinct(wmo, temp_datetime_local, .keep_all = TRUE)
```

```{r}
# Read in the weather station data
weather_stations <- read_csv('weather_stations_current_data.csv', show_col_types = FALSE)
```


```{r}
# Load the forecast data, join in the timezones and add in
# a request time in the local time of the weather station
    forecast_data <-
    list.files('forecast_data', recursive = TRUE, pattern = '*.csv', full.names = TRUE) |>
    read_csv(show_col_types = FALSE) |> 
    left_join(wmo_timezones, by = 'wmo') |>
    rename(
        request_datetime_utc = request_datetime,
        forecast_datetime_local = forecast_datetime
    ) |> 
    mutate(
        request_datetime_local_floored = floor_date(request_datetime_utc, '10 minutes') + timezone
    ) |>
    select(request_datetime_local_floored, forecast_datetime_local, site, wmo, location, forecast_temp)
```


```{r weather_stations, eval=FALSE, include=FALSE}
weather_stations_raw <-
    request('http://www.bom.gov.au/climate/data/lists_by_element/stations.txt') |>
    req_user_agent('Mozilla') |>
    req_perform() |>
    resp_body_string() 

weather_stations <-
    weather_stations_raw |> 
    read_fwf(skip = 3, show_col_types = FALSE) |>  
    rename(
        site = X1, dist = X2, site_name = X3, start = X4,
        end = X5, lat = X6, lon = X7, source = X8,
        state = X9, height = X10, bar_ht = X11, wmo = X12
    ) |>
    slice_head(n = -6) 

nearest_location <- function(loc_html) {
        tibble(
            location = html_element(loc_html, 'a') |> html_text(),
            path = html_element(loc_html, 'a') |> html_attr('href'),
            loc_lat = html_element(loc_html, 'li') |> html_attr('data-lat'),
            loc_lon = html_element(loc_html, 'li') |> html_attr('data-lon')
        )
}

weather_stations_location <-
    weather_stations |>
    slice_tail(n = -1) |> 
    filter(wmo != '..') |> 
    mutate(reqs = map2(lat, lon, ~{ glue('http://www.bom.gov.au/places/search/?q={.x},{.y}&suggest=1') |> request() |> req_user_agent('Mozilla') })) |>
    mutate(nearest_location = req_perform_parallel(reqs) |> resps_successes() |> resps_data(resp_data = \(resp)(list(nearest_location(resp_body_html(resp)))))) |>
    select(-reqs) |> 
    unnest(nearest_location)
```

# Weather Stations

```{r}
aus <- ne_countries(returnclass = "sf", scale = 'medium', country = 'Australia')
aus |>
    ggplot() +
    geom_sf() +
    geom_point(data = weather_stations, aes(x = lon, y = lat), size = .4) +
    labs(
        x = '',
        y = ''
    )
```

# Temperature Analysis

```{r echo=FALSE}
temp_data |>
    ggplot() +
    geom_point(aes(request_datetime_utc_floored, temperature, colour = state), size = .1, alpha = .1) +
    guides(colour = guide_legend(override.aes = list(size = 2, alpha = 1)))
```

```{r echo=FALSE}
# Calculate the mean temperature per station ID, then slice the stations with
# the highest and lowest mean temperature, then graph these
temp_data |>
    group_by(station_id) |>
    summarise(
        mean_temp = mean(temperature, na.rm = TRUE)
    ) |>
    ungroup() |>
    (\(x)
        bind_rows(
            slice_min(x, n = 1, mean_temp),
            slice_max(x, n = 1, mean_temp)
        )
    )() |>
    left_join(temp_data, by = 'station_id') |>
    ggplot() +
    geom_point(aes(request_datetime_utc_floored, temperature, colour = paste(city, state, sep = ', ')), size = .5) +
    geom_hline(aes(yintercept = mean_temp, colour = paste(city, state, sep = ', '))) +
    labs(
        colour = 'City, State',
        x = 'Date/Time',
        y = 'Temperature'
    )  +
    guides(colour = guide_legend(override.aes = list(size = 2, alpha = 1)))
```

